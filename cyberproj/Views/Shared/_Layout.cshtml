<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Moduł 1</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">Moduł 1 - Autoryzacja</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <ul class="navbar-nav me-auto">
                @if (User.Can(Permissions.UsersView))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Użytkownicy</a></li>
                }
                @if (User.Can(Permissions.SettingsManage))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Settings" asp-action="Index">Ustawienia</a></li>
                }
                <li class="nav-item"><a class="nav-link" asp-controller="Articles" asp-action="Index">Artykuły</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="ChangePassword">Zmień hasło</a></li>
            </ul>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center">
                <span class="navbar-text me-3">@User.Identity!.Name (@User.RoleName())</span>
                <button type="submit" class="btn btn-outline-light btn-sm">Wyloguj</button>
            </form>
        }
    </div>
</nav>
<div class="container">
    @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
    @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
    @RenderBody()
</div>
</body>
</html>