@model LoginViewModel
@{ ViewData["Title"] = "Logowanie"; }
<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-3">Logowanie</h2>
        @if (ViewBag.Info is string info) { <div class="alert alert-info">@info</div> }
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <form asp-action="Login" method="post" autocomplete="off">
            <div class="mb-3">
                <label asp-for="Login" class="form-label">Login</label>
                <input asp-for="Login" class="form-control" autofocus />
                <span asp-validation-for="Login" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Hasło</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Zaloguj</button>
        </form>
    </div>
</div>
