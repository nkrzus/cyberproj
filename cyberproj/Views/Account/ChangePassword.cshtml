@model ChangePasswordViewModel
@{
    bool forced = ViewBag.Forced == true;
    ViewData["Title"] = forced ? "Pierwsze logowanie" : "Zmiana hasła";
    var hint = ViewBag.Hint as List<string> ?? new List<string>();
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-3">@ViewData["Title"]</h2>
        @if (forced)
        {
            <div class="alert alert-warning">Zalogowano hasłem jednorazowym. Aby kontynuować, ustaw własne hasło.</div>
        }
        <div class="alert alert-secondary">
            <strong>Wymagania dla nowego hasła:</strong>
            <ul class="mb-0">@foreach (var h in hint) {
                <li>@h</li>
            }
        </ul>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form asp-action="@(forced ? "FirstLogin" : "ChangePassword")" method="post" autocomplete="off">
        @if (!forced)
        {
            <div class="mb-3">
                <label asp-for="OldPassword" class="form-label">Stare hasło</label>
                <input asp-for="OldPassword" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>
        }
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">Nowe hasło</label>
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Powtórz nowe hasło</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Zmień hasło</button>
    </form>
</div>
</div>
