@{ ViewData["Title"] = "Start"; }
<h1>Witaj, @User.Identity!.Name</h1>
<p>Twoja rola: <strong>@User.RoleName()</strong></p>

<h5 class="mt-4">Twoje uprawnienia</h5>
<ul>
    @foreach (var p in Permissions.ForRole(User.RoleName()))
    {
        <li><code>@p</code> - @Permissions.Descriptions[p]</li>
    }
</ul>