@model EditUserViewModel
@{ ViewData["Title"] = "Edycja użytkownika"; }
<div class="row"><div class="col-md-6">
    <h2 class="mb-3">Edycja: @Model.Login</h2>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Imię i nazwisko</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Role" class="form-label">Rola</label>
            <select asp-for="Role" asp-items="@(new SelectList(Roles.Assignable))" class="form-select"></select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Zapisz</button>
        <a asp-action="Index" class="btn btn-link">Anuluj</a>
    </form>
</div></div>
